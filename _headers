# Cloudflare Pages — HTTP Headers for optimal caching & security
# ==============================================================

# ── HTML: no cache (always get latest version) ──
/index.html
  Cache-Control: no-cache, must-revalidate
  X-Robots-Tag: index, follow

# ── Production bundle: cache 1 week (versioned via ?v= query string) ──
/bundle.js
  Cache-Control: public, max-age=604800

# ── Subject data files: cache 1 month (rarely change, loaded dynamically) ──
/src/modules/question-bank/subjects/*
  Cache-Control: public, max-age=2592000

# ── External libraries: cache 1 month ──
/src/lib/*
  Cache-Control: public, max-age=2592000

# ── SPA routing redirects: no cache ──
/_redirects
  Cache-Control: no-cache

# ── Service Worker: no cache (if added later) ──
/sw.js
  Cache-Control: no-cache, must-revalidate

# ── Global security headers ──
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
